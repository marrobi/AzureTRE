// Azure TRE settings for pgsc_calc. The head replaces @TRE_REGISTRY@ with the TRE container registry.
params {
    // The bundled example: CINECA synthetic genomes (chr22) scored with PGS001229, a height score
    // trained on UK Biobank by the Global Biobank Engine.
    input        = "${projectDir}/assets/examples/samplesheet.csv"
    format       = 'csv'
    scorefile    = "${projectDir}/assets/examples/scorefiles/PGS001229_22.txt"
    target_build = 'GRCh37'
}

process {
    withLabel: pgscatalog_utils { ext.docker = '@TRE_REGISTRY@/mirror/ghcr.io/pgscatalog/pygscatalog' }
    withLabel: plink2           { ext.docker = '@TRE_REGISTRY@/mirror/ghcr.io/pgscatalog/plink2' }
    withLabel: zstd             { ext.docker = '@TRE_REGISTRY@/mirror/ghcr.io/pgscatalog/zstd' }
    withLabel: report           { ext.docker = '@TRE_REGISTRY@/mirror/ghcr.io/pgscatalog/report' }
    withLabel: pyyaml           { ext.docker = '@TRE_REGISTRY@/mirror/ghcr.io/pgscatalog/pyyaml' }
    withLabel: fraposa          { ext.docker = '@TRE_REGISTRY@/mirror/ghcr.io/pgscatalog/fraposa_pgsc' }
}
